# Normalize line endings: LF on checkout for code, autocrlf for the rest.
* text=auto
*.py text eol=lf
*.jinja text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.ya?ml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
# Keep pinned upstream assets byte-identical on Windows checkouts, including LICENSE.
novacode_cli/prompts/ponytail/** text eol=lf
