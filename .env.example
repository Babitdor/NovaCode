# Async-agent LangGraph server config.
# docker-compose seeds .env from this file on first run; copy + edit as needed:
#   cp .env.example .env

# Which provider + model the six async agents run on. Default is Ollama, and
# DOC_AGENT_MODEL is still honoured as the fallback for the model id, so an
# existing .env keeps working untouched. Providers: ollama, openai, anthropic,
# google, openrouter, opencode, nvidia (the last two need ASYNC_AGENT_MODEL set;
# each keyed provider reads its own API key variable, listed in
# novacode_cli/config/model_create.py PROVIDER_KEY_ENV).
#
# To run the background agents on OpenAI instead of Ollama, for example:
#   ASYNC_AGENT_PROVIDER=openai
#   ASYNC_AGENT_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...
# For a self-hosted OpenAI-compatible endpoint, add OPENAI_BASE_URL (the shared
# constructor already honours it). ASYNC_AGENT_MODEL_BASE_URL does not exist:
# ASYNC_AGENT_BASE_URL means the LangGraph server, not the model.
ASYNC_AGENT_PROVIDER=ollama
ASYNC_AGENT_MODEL=

# This pair is the "async agents" role. /model writes it into Nova.config.json, and
# a server Nova launches itself receives it as these variables; an explicit value
# here still wins. The Docker container reads this file instead, so it needs the
# service recreated to pick up a change.

# Fallback model id, still honoured when ASYNC_AGENT_MODEL is empty.
DOC_AGENT_MODEL=gemma4:31b-cloud

# Ollama endpoint. Inside the compose network this is the bundled ollama service.
# Point at a remote/cloud Ollama by overriding this.
OLLAMA_BASE_URL=http://ollama:11434

# Base URL the NOVA CLI uses to reach the async-agent server. When the server
# runs via this compose file, it's published on localhost:2024.
#
# Only needed if you run the server yourself on a non-default host or port: NOVA
# sets this for the current process when it launches its own server (see the
# README's "Async subagents without Docker"), and falls back to http://localhost.
ASYNC_AGENT_BASE_URL=http://localhost

# Optional auth for the LangGraph server (leave blank for a local, unauthenticated
# server). If set, the CLI sends it as a Bearer token.
LANGGRAPH_API_KEY=

# Optional: LangSmith tracing for the async agents.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
