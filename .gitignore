# Graphify — the /graphify skill writes its knowledge-graph output + AST cache
# here. The dir uses a hyphen; the old underscore pattern never matched it, so
# the multi-MB cache leaked into `git status`. Ignore both spellings.
graphify-out/
graphify_out/

# Runtime data (never commit)
conversation_history/
novacode_cli/cli_session/

# Project directories (external projects)
# Local working checkout of an external agent repo (has its own .git) — never
# vendor it into this repository.
prime-agent/

# Ad-hoc debugging probe scripts — scratch, never part of the tree
_probe_*.py
# Same, when the file is named to describe what it audits rather than what it
# probes. Kept as an exact path so a real module can never be caught by it.
novacode_cli/_audit_probe.py
# Scratch working directory for one-off analysis scripts and captured output.
tmp/

# Screenshots used while iterating on the TUI — not documentation, not shipped.
/UI.png
/UI-*.png
