<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'none'; img-src 'none'">
<title>Nova · Project onboarding</title>
<style>
:root {
  color-scheme:dark; --bg:#13141d; --surface:#1a1b26; --panel:#24283b;
  --ink:#c0caf5; --muted:#99a6ce; --line:#343b55; --control:#65739a;
  --blue:#7aa2f7; --violet:#bb9af7; --green:#9ece6a; --amber:#e0af68;
  --mono:"Cascadia Code","SFMono-Regular",Consolas,monospace;
  --display:"Bahnschrift","Aptos Display","Segoe UI",sans-serif;
  font:14px/1.6 "Segoe UI",system-ui,sans-serif; background:var(--bg); color:var(--ink);
}
* { box-sizing:border-box; }
body { margin:0; }
button,input,select,textarea { font:inherit; color:inherit; border:1px solid var(--control); border-radius:6px; background:var(--surface); }
button { cursor:pointer; min-height:40px; padding:8px 14px; text-align:left; }
button:disabled { opacity:.4; cursor:default; }
button:hover:not(:disabled) { border-color:var(--blue); background:var(--panel); }
:focus-visible { outline:2px solid var(--blue); outline-offset:4px; }
input,select,textarea { width:100%; padding:10px 12px; margin-top:7px; }
input::placeholder,textarea::placeholder { color:var(--muted); opacity:.85; }
label { font-size:12px; color:var(--muted); }
textarea { resize:vertical; min-height:100px; }
select { cursor:pointer; }
h1,h2,h3,p { margin:0; }
h1,h2,h3 { font-family:var(--display); font-weight:600; line-height:1.25; }
h1 { font-size:clamp(26px,3vw,39px); letter-spacing:-.035em; overflow-wrap:anywhere; }
h2 { font-size:20px; letter-spacing:-.025em; }
h3 { font-size:18px; }
code,pre { font-family:var(--mono); }
.muted { color:var(--muted); }
.eyebrow { font:11px/1.5 var(--mono); letter-spacing:.1em; text-transform:uppercase; color:var(--muted); }
.topbar { min-height:78px; display:flex; align-items:center; justify-content:space-between; gap:24px; padding:18px 32px; border-bottom:1px solid var(--line); background:var(--surface); }
.brand { display:flex; align-items:center; gap:25px; }
#wordmark { margin:0; font:5.5px/1.15 var(--mono); color:var(--violet); white-space:pre; }
.brand-divider { height:25px; border-left:1px solid var(--line); }
.brand-label { font:12px var(--mono); color:var(--muted); }
.local { display:flex; align-items:center; gap:9px; color:var(--muted); font:11px var(--mono); }
.status-dot { width:6px; height:6px; display:inline-block; border-radius:50%; background:var(--green); flex-shrink:0; }
.shell { max-width:1800px; margin:auto; padding:30px 32px 18px; }
.overview { display:flex; justify-content:space-between; align-items:flex-end; gap:30px; margin-bottom:28px; }
.overview .eyebrow { margin-bottom:10px; }
.project-meta { display:flex; align-items:center; gap:22px; flex-wrap:wrap; margin-top:14px; }
#stats { font:12px var(--mono); color:var(--muted); }
#freshness { color:var(--green); font-size:12px; max-width:510px; }
#freshness.warning { color:var(--amber); }
.overview-note { max-width:270px; text-align:right; color:var(--muted); font-size:13px; }
nav { display:flex; gap:5px; border-bottom:1px solid var(--line); margin-bottom:24px; overflow-x:auto; }
nav button { display:flex; align-items:center; gap:9px; flex-shrink:0; background:transparent; border:0; border-bottom:2px solid transparent; border-radius:0; color:var(--muted); padding:12px 17px 15px; }
nav button:hover:not(:disabled) { background:var(--surface); }
nav button[aria-pressed=true] { color:var(--violet); border-bottom-color:var(--violet); }
.nav-icon { font-family:var(--mono); font-size:16px; width:18px; text-align:center; }
.workspace { display:grid; grid-template-columns:250px minmax(0,1fr) 290px; min-height:620px; border:1px solid var(--line); border-radius:10px; overflow:hidden; background:var(--surface); }
.explorer,.inspector { min-width:0; padding:20px 16px; }
.explorer { border-right:1px solid var(--line); }
.panel-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; }
.panel-heading h2 { font:12px var(--mono); color:var(--muted); }
.panel-heading span { color:var(--violet); }
.search-wrap { position:relative; margin-bottom:15px; }
.search-wrap input { padding-left:33px; margin:0; }
.search-glyph { position:absolute; left:12px; top:9px; color:var(--muted); pointer-events:none; }
.sr-only { position:absolute; width:1px; height:1px; margin:-1px; padding:0; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
#result-count { font:10px/1.5 var(--mono); color:var(--muted); padding:17px 0 10px; }
#results { display:flex; flex-direction:column; gap:3px; max-height:440px; overflow:auto; scrollbar-width:thin; scrollbar-color:var(--line) transparent; }
.node-result { width:100%; display:flex; gap:10px; border:1px solid transparent; border-radius:5px; background:transparent; padding:9px 7px; min-height:44px; }
.node-result:hover:not(:disabled) { border-color:var(--line); }
.node-result[aria-current=true] { background:var(--panel); border-color:var(--line); }
.node-mark { font:12px var(--mono); color:var(--blue); width:18px; flex-shrink:0; padding-top:2px; }
.node-mark.symbol { color:var(--violet); }
.node-copy { overflow:hidden; }
.node-name { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font:12px/1.6 var(--mono); }
.node-path { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--muted); font-size:10px; margin-top:2px; }
.stage { min-width:0; position:relative; display:flex; flex-direction:column; background:var(--bg); }
.stage-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:16px 20px; border-bottom:1px solid var(--line); }
.stage-toolbar h2 { font-size:14px; }
.stage-toolbar .muted { font:10px var(--mono); }
.graph-controls { display:flex; gap:5px; }
.graph-controls button { min-width:32px; min-height:32px; padding:2px 8px; text-align:center; font:13px var(--mono); border-color:var(--line); }
.graph-field { position:relative; flex:1; min-height:490px; background-image:radial-gradient(#343b5570 1px,transparent 1px); background-size:22px 22px; }
#graph { width:100%; height:100%; min-height:490px; display:block; position:absolute; inset:0; }
#graph .edge { stroke:var(--blue); stroke-width:1.2; opacity:.35; }
#graph .edge.containment { stroke:var(--muted); opacity:.18; stroke-dasharray:4 5; }
#graph .edge.call { stroke:var(--violet); opacity:.65; }
#graph .graph-node { cursor:pointer; outline:none; }
#graph .node-core { fill:var(--panel); stroke:var(--blue); stroke-width:2; }
#graph .graph-node.symbol .node-core { stroke:var(--violet); }
#graph .node-halo { fill:var(--bg); stroke:var(--line); stroke-width:1; }
#graph .graph-node:hover .node-core,#graph .graph-node:focus .node-core { fill:var(--blue); }
#graph .graph-node.symbol:hover .node-core,#graph .graph-node.symbol:focus .node-core { fill:var(--violet); }
#graph .graph-node:focus .node-halo { stroke:var(--ink); stroke-width:2; }
#graph .graph-node:focus .selected-box { stroke:var(--ink); stroke-width:3; }
#graph text { fill:var(--muted); font:13px var(--mono); pointer-events:none; }
#graph .selected-box { fill:var(--panel); stroke:var(--violet); stroke-width:1.5; }
#graph .selected-ring { fill:none; stroke:var(--violet); opacity:.15; }
#graph .selected-name { fill:var(--ink); font-size:16px; }
#graph .selected-kind { fill:var(--violet); font-size:10px; letter-spacing:1px; }
#graph .minor-label { opacity:0; }
#graph .graph-node:hover .minor-label,#graph .graph-node:focus .minor-label { opacity:1; paint-order:stroke; stroke:var(--bg); stroke-width:5px; stroke-linejoin:round; }
#graph[data-compact=true] text { font-size:18px; }
#graph[data-compact=true] .selected-name { font-size:20px; }
#graph[data-compact=true] .selected-kind { font-size:12px; }
.graph-footer { border-top:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; padding:12px 18px; color:var(--muted); font:10px var(--mono); }
.legend { display:flex; gap:15px; }
.legend span { display:flex; align-items:center; gap:6px; }
.legend i { width:5px; height:5px; border-radius:50%; background:var(--blue); }
.legend .symbol i { background:var(--violet); }
.inspector { border-left:1px solid var(--line); }
#selection { font:15px/1.5 var(--mono); overflow-wrap:anywhere; margin:15px 0 9px; color:var(--ink); }
#location { overflow-wrap:anywhere; font:11px/1.7 var(--mono); color:var(--muted); }
.node-facts { display:flex; gap:25px; margin:23px 0; padding:16px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
.node-facts strong { display:block; font:20px var(--display); color:var(--ink); }
.node-facts span { color:var(--muted); font-size:10px; }
.primary { background:var(--violet); color:var(--bg); border-color:var(--violet); font-weight:600; }
.primary:hover:not(:disabled) { background:#cfb4ff; border-color:#cfb4ff; color:var(--bg); }
#impact { width:100%; display:flex; justify-content:space-between; }
.relation-heading { font:11px var(--mono); color:var(--muted); margin:27px 0 12px; }
#relationships { max-height:270px; overflow:auto; scrollbar-width:thin; scrollbar-color:var(--line) transparent; }
#relationships button { display:block; width:100%; border:0; border-top:1px solid var(--line); border-radius:0; padding:11px 1px; background:transparent; overflow-wrap:anywhere; font:11px/1.7 var(--mono); }
#relationships p { color:var(--muted); font-size:12px; margin-bottom:12px; }
.empty { padding:18px 6px; color:var(--muted); font-size:12px; }
.page-footer { display:flex; justify-content:space-between; gap:20px; padding:18px 2px 0; font:10px/1.6 var(--mono); color:var(--muted); }
.page-footer #limits { max-width:850px; }
.page-footer code { color:var(--violet); white-space:nowrap; }
.content-panel { border:1px solid var(--line); border-radius:10px; background:var(--surface); padding:32px; }
.content-panel > h2 { margin:9px 0 13px; font-size:28px; }
.content-panel > p { color:var(--muted); max-width:660px; }
.tour-layout { display:grid; grid-template-columns:280px minmax(0,1fr); gap:40px; margin-top:30px; }
#tour-stops { list-style:none; padding:0; margin:0; }
#tour-stops button { display:flex; width:100%; gap:12px; border:1px solid transparent; background:transparent; margin-bottom:4px; overflow:hidden; }
#tour-stops button[aria-current=step] { background:var(--panel); border-color:var(--line); }
.stop-number { font:12px var(--mono); color:var(--violet); padding-top:1px; }
.tour-detail { border-left:1px solid var(--line); padding-left:36px; min-width:0; }
#tour-title { font:11px var(--mono); color:var(--violet); margin-bottom:15px; }
#tour-path { font:19px/1.6 var(--mono); overflow-wrap:anywhere; margin-bottom:20px; }
#tour-symbols { display:flex; gap:8px; flex-wrap:wrap; padding:22px 0; }
#tour-symbols button { font:11px var(--mono); min-height:36px; overflow-wrap:anywhere; }
.tour-controls { display:flex; flex-wrap:wrap; gap:9px; margin-top:20px; }
.document { max-width:950px; margin:auto; }
#guide-text { overflow-wrap:anywhere; font-size:15px; line-height:1.9; padding-top:26px; margin-top:26px; border-top:1px solid var(--line); color:var(--ink); }
#guide-text h1 { font-size:28px; margin:0 0 20px; }
#guide-text h2 { font-size:21px; margin:32px 0 15px; padding-top:24px; border-top:1px solid var(--line); }
#guide-text h3 { margin:24px 0 12px; }
#guide-text p,#guide-text ul,#guide-text ol { margin:12px 0; }
#guide-text li { margin:6px 0; }
#guide-text a { color:var(--blue); text-underline-offset:3px; }
#guide-text code { font-size:85%; padding:3px 6px; border-radius:4px; background:var(--panel); color:var(--blue); }
#guide-text pre { max-width:100%; overflow:auto; padding:18px; border:1px solid var(--line); border-radius:6px; background:var(--bg); }
#guide-text pre code { padding:0; background:transparent; color:var(--ink); }
.ask-layout { display:grid; grid-template-columns:minmax(0,1fr) minmax(250px,.8fr); gap:50px; margin-top:30px; }
.ask-layout label { display:block; margin:18px 0 5px; }
.ask-layout textarea { margin-bottom:15px; }
.command-card { padding:25px; background:var(--bg); border:1px solid var(--line); border-radius:8px; }
.command-card h3 { margin-bottom:16px; }
.command-card p { color:var(--muted); font-size:12px; }
.command-card code { color:var(--blue); }
#ask-command { font:12px/1.8 var(--mono); color:var(--green); min-height:130px; }
.question-suggestions { display:flex; gap:7px; flex-wrap:wrap; margin-top:16px; }
.question-suggestions button { font-size:11px; min-height:34px; border-color:var(--line); }
[hidden] { display:none!important; }
@media(max-width:760px) { .graph-controls button,#tour-symbols button,.question-suggestions button { min-height:44px; } .graph-controls button { min-width:44px; } }
@media(prefers-reduced-motion:no-preference) { .overview,.workspace,.content-panel { animation:arrive .25s ease-out; } button { transition:background .15s,border-color .15s; } @keyframes arrive { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:none; } } }
@media(min-width:1500px) { .workspace { grid-template-columns:270px minmax(0,1fr) 320px; } .graph-field,#graph { min-height:580px; } }
@media(max-width:1100px) { .workspace { grid-template-columns:220px minmax(0,1fr); } .inspector { grid-column:1/-1; display:grid; grid-template-columns:1fr 1fr; gap:0 32px; border-left:0; border-top:1px solid var(--line); } .inspector .panel-heading,.inspector #selection,.inspector #location,.inspector .node-facts,.inspector #impact { grid-column:1; } .inspector .relation-heading { grid-column:2; grid-row:1/3; margin:0; } #relationships { grid-column:2; grid-row:3/7; } .overview-note { display:none; } }
@media(max-width:760px) { .topbar { padding:16px; min-height:70px; } .brand { gap:15px; } .brand-label { font-size:10px; } .local { display:none; } .shell { padding:24px 14px 14px; } .overview { margin-bottom:20px; } .project-meta { gap:10px; } #stats { line-height:1.8; font-size:10px; } nav { margin-bottom:17px; } nav button { padding:10px 13px 12px; min-height:44px; } .workspace { grid-template-columns:minmax(0,1fr); } .explorer { border-right:0; border-bottom:1px solid var(--line); padding:18px; } #results { max-height:180px; } .graph-field,#graph { min-height:400px; } .stage-toolbar { padding:13px 15px; } .stage-toolbar .muted { display:none; } .inspector { display:block; padding:22px; } .inspector .relation-heading { margin:24px 0 10px; } .node-facts { margin:18px 0; } .page-footer { flex-direction:column; gap:8px; } .content-panel { padding:23px; } .tour-layout,.ask-layout { grid-template-columns:minmax(0,1fr); gap:25px; } #tour-stops { max-height:230px; overflow:auto; } .tour-detail { border-left:0; padding:24px 0 0; border-top:1px solid var(--line); } .content-panel > h2 { font-size:25px; } button { min-height:44px; } }
</style>
</head>
<body>
<header class="topbar">
  <div class="brand"><pre id="wordmark" role="img" aria-label="Nova"></pre><span class="brand-divider" aria-hidden="true"></span><span class="brand-label">project onboarding</span></div>
  <span class="local"><i class="status-dot" aria-hidden="true"></i>Local analysis · private by default</span>
</header>
<main class="shell">
  <div class="overview">
    <div><p class="eyebrow">Workspace / Understand your code</p><h1 id="project"></h1><div class="project-meta"><p id="stats"></p><p id="freshness" role="status"></p></div></div>
    <div class="overview-note"><p class="eyebrow">Last analyzed</p><time id="analyzed-date"></time></div>
  </div>
  <nav aria-label="Explore project">
    <button type="button" data-tab="map" aria-pressed="true"><span class="nav-icon" aria-hidden="true">⌘</span>Code map</button>
    <button type="button" data-tab="tour" aria-pressed="false"><span class="nav-icon" aria-hidden="true">↗</span>Guided tour</button>
    <button type="button" data-tab="guide" aria-pressed="false"><span class="nav-icon" aria-hidden="true">≡</span>Architecture &amp; guide</button>
    <button type="button" data-tab="ask" aria-pressed="false"><span class="nav-icon" aria-hidden="true">✧</span>Ask Nova</button>
  </nav>
  <section id="map" class="workspace" aria-label="Code map">
    <aside class="explorer">
      <div class="panel-heading"><h2>EXPLORER</h2><span aria-hidden="true">⌕</span></div>
      <div class="search-wrap"><label for="search" class="sr-only">Search files and symbols</label><span class="search-glyph" aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Find a file or symbol…"></div>
      <label for="layer">Directory</label><select id="layer"><option value="">All directories</option></select>
      <p id="result-count" aria-live="polite"></p><div id="results"></div>
    </aside>
    <div class="stage">
      <div class="stage-toolbar"><div><h2>Dependency map</h2><span class="muted">Select a node to inspect its connections</span></div><div class="graph-controls" aria-label="Map controls"><button id="zoom-out" type="button" aria-label="Zoom out">−</button><button id="zoom-in" type="button" aria-label="Zoom in">+</button><button id="reset-view" type="button" aria-label="Reset map view">↺</button></div></div>
      <div class="graph-field"><svg id="graph" viewBox="0 0 960 620" aria-label="Dependency neighborhood" role="group"></svg></div>
      <div class="graph-footer"><div class="legend"><span><i></i>File</span><span class="symbol"><i></i>Symbol</span></div><span id="map-count">Select a node to explore</span></div>
    </div>
    <aside class="inspector">
      <div class="panel-heading"><h2>INSPECTOR</h2><span aria-hidden="true">↗</span></div><h2 id="selection">Select a node</h2><p id="location"></p>
      <div class="node-facts"><div><strong id="incoming-count">0</strong><span>incoming</span></div><div><strong id="outgoing-count">0</strong><span>outgoing</span></div></div>
      <button id="impact" class="primary" type="button">Trace change impact<span aria-hidden="true">↗</span></button>
      <h3 class="relation-heading" id="relationship-heading">RELATIONSHIPS</h3><div id="relationships"></div>
    </aside>
  </section>
  <section id="tour" class="content-panel" hidden>
    <p class="eyebrow">A way into the code</p><h2>Start here. Follow the thread.</h2><p>Move through documentation, entry points, and connected files. Explore the symbols at each stop, then ask Nova how they fit together.</p>
    <div class="tour-layout"><ol id="tour-stops" aria-label="Learning tour stops"></ol><div class="tour-detail"><h3 id="tour-title"></h3><p id="tour-path"></p><p class="muted">Explore the file’s symbols below, or open its connections in the code map.</p><div id="tour-symbols"></div><div class="tour-controls"><button id="previous" type="button">← Previous</button><button id="next" type="button">Next →</button><button id="tour-map" class="primary" type="button">Explore this file ↗</button></div></div></div>
  </section>
  <section id="guide" class="content-panel document" hidden><p class="eyebrow">The bigger picture</p><h2>Architecture &amp; onboarding guide</h2><p>Keep the project’s structure and learning path close as you explore.</p><article id="guide-text">__NOVA_ONBOARD_GUIDE__</article></section>
  <section id="ask" class="content-panel" hidden>
    <p class="eyebrow">Keep exploring</p><h2>Ask about the code.</h2><p>Take a question back to your Nova conversation. Nova can use the saved map and read the source to explain what happens.</p>
    <div class="ask-layout"><div><label for="question">What would you like to understand?</label><textarea id="question" rows="4" placeholder="How does a request move through this project?"></textarea><button id="prepare" class="primary" type="button" disabled>Prepare question ↗</button><div class="question-suggestions"><button type="button" data-question="Where does execution begin?">Find the entry point</button><button type="button" data-question="How does data move through this project?">Follow the data</button><button type="button" data-question="Which files should I read first, and why?">Choose a starting point</button></div></div><div class="command-card"><p class="eyebrow">Continue in Nova</p><label for="ask-command">Copy this command into your conversation</label><textarea id="ask-command" rows="4" readonly placeholder="Your question will appear here."></textarea><p>Questions use your configured model and normal tool permissions. This dashboard stays local and has no model credentials.</p><p style="margin-top:18px"><code>/onboard impact &lt;name or path&gt;</code><br>Check dependencies before a change.<br><code>/onboard refresh</code><br>Update the map after editing code.</p></div></div>
  </section>
  <footer class="page-footer"><p id="limits"></p><span>Open your saved map with <code>/onboard open</code></span></footer>
</main>
<script>
'use strict';
const data = __NOVA_ONBOARD_DATA__;
const $ = id => document.getElementById(id);
const byId = new Map(data.nodes.map(n => [n.id,n]));
const incoming = new Map(), adjacent = new Map();
for (const edge of data.edges) {
  for (const id of new Set([edge.source,edge.target])) {
    if (!adjacent.has(id)) adjacent.set(id,[]);
    adjacent.get(id).push(edge);
  }
  if (edge.type !== 'contains') {
    if (!incoming.has(edge.target)) incoming.set(edge.target,[]);
    incoming.get(edge.target).push(edge.source);
  }
}
let selected=null, tourIndex=0, view=[0,0,960,620];
const compact=window.matchMedia('(max-width:760px)');
compact.addEventListener('change',()=>{if(selected) select(selected.id);});
function text(id,value) { $(id).textContent=value; }
function button(label,action) {
  const node=document.createElement('button'); node.type='button'; node.textContent=label;
  node.addEventListener('click',action); return node;
}
function tab(id) {
  document.querySelectorAll('main > section').forEach(section => section.hidden=section.id!==id);
  document.querySelectorAll('[data-tab]').forEach(node => node.setAttribute('aria-pressed',String(node.dataset.tab===id)));
}
document.querySelectorAll('[data-tab]').forEach(node => node.addEventListener('click',()=>tab(node.dataset.tab)));
text('wordmark',data.wordmark); text('project',data.project);
const analyzed=new Date(data.analyzed_at);
text('analyzed-date',Number.isNaN(analyzed.getTime()) ? 'Date unavailable' : analyzed.toLocaleString(undefined,{dateStyle:'medium',timeStyle:'short'}));
text('stats',`${Object.keys(data.fingerprints).length.toLocaleString()} files  /  ${data.nodes.length.toLocaleString()} nodes  /  ${data.edges.length.toLocaleString()} connections`);
text('freshness',data.changes.length ? `${data.changes.length} changed files · Run /onboard refresh` : 'Snapshot matches workspace');
$('freshness').title=`Analyzed ${data.analyzed_at}. Freshness was checked when this dashboard opened.`;
if (data.changes.length) $('freshness').className='warning';
text('limits',data.limits);
document.querySelectorAll('#guide-text a').forEach(link=>{link.target='_blank';link.rel='noopener noreferrer';});
for (const name of data.layers) {
  const option=document.createElement('option'); option.value=name; option.textContent=name; $('layer').append(option);
}
function results() {
  const query=$('search').value.toLowerCase(), group=$('layer').value;
  const matches=data.nodes.filter(node => (node.name+' '+node.path).toLowerCase().includes(query) && (!group || (node.path.includes('/') ? node.path.split('/')[0] : 'Project root')===group));
  $('results').replaceChildren(...matches.slice(0,100).map(node => {
    const item=button('',()=>select(node.id)); item.className='node-result'; item.dataset.node=node.id;
    item.setAttribute('aria-current',String(node.id===selected?.id)); item.title=node.name+' — '+node.path;
    const mark=document.createElement('span'); mark.className='node-mark'+(node.kind==='file' ? '' : ' symbol'); mark.textContent=node.kind==='file' ? '▤' : '◇'; mark.setAttribute('aria-hidden','true');
    const copy=document.createElement('span'); copy.className='node-copy';
    const name=document.createElement('span'); name.className='node-name'; name.textContent=node.name;
    const path=document.createElement('span'); path.className='node-path'; path.textContent=node.path;
    copy.append(name,path); item.append(mark,copy); return item;
  }));
  if (!matches.length) {
    const empty=document.createElement('p'); empty.className='empty'; empty.textContent='No matching files or symbols. Try another name or choose all directories.'; $('results').append(empty);
  }
  text('result-count',`${matches.length.toLocaleString()} results${matches.length>100 ? ' · first 100 shown' : ''}`);
}
$('search').addEventListener('input',results); $('layer').addEventListener('change',results);
function element(name,attributes) {
  const node=document.createElementNS('http://www.w3.org/2000/svg',name);
  for (const [key,value] of Object.entries(attributes)) node.setAttribute(key,String(value)); return node;
}
function resetView() { view=[0,0,compact.matches ? 600 : 960,620]; $('graph').setAttribute('viewBox',view.join(' ')); }
function zoom(factor) {
  const base=compact.matches ? 600 : 960;
  const width=Math.max(base*.45,Math.min(base*2,view[2]*factor)), height=width*620/base;
  view=[view[0]+(view[2]-width)/2,view[1]+(view[3]-height)/2,width,height];
  $('graph').setAttribute('viewBox',view.join(' '));
}
$('zoom-in').addEventListener('click',()=>zoom(0.75)); $('zoom-out').addEventListener('click',()=>zoom(1.3)); $('reset-view').addEventListener('click',resetView);
function select(id) {
  const restoreFocus=$('graph').contains(document.activeElement);
  selected=byId.get(id); if (!selected) return;
  text('selection',selected.name); text('location',`${selected.path}${selected.line ? ' · '+selected.line : ''}`);
  const edges=adjacent.get(id)||[];
  text('incoming-count',edges.filter(edge=>edge.target===id).length);
  text('outgoing-count',edges.filter(edge=>edge.source===id).length);
  text('relationship-heading','RELATIONSHIPS');
  document.querySelectorAll('[data-node]').forEach(node=>node.setAttribute('aria-current',String(node.dataset.node===id)));
  const allNeighbors=[...new Set(edges.flatMap(edge=>[edge.source,edge.target]))].filter(node=>node!==id && byId.has(node));
  const neighbors=allNeighbors.slice(0,compact.matches ? 8 : 40), center=compact.matches ? 300 : 480;
  text('map-count',`${neighbors.length} of ${allNeighbors.length} neighbors shown · Select to follow`);
  const points=new Map([[id,[center,310]]]);
  neighbors.forEach((node,index)=>{
    const outer=index>=12, offset=outer ? index-12 : index;
    const count=outer ? neighbors.length-12 : Math.min(12,neighbors.length);
    const angle=offset*2*Math.PI/count-Math.PI/2+(outer ? .12 : 0);
    points.set(node,[center+(compact.matches ? 200 : outer ? 355 : 235)*Math.cos(angle),310+(compact.matches ? 210 : outer ? 245 : 170)*Math.sin(angle)]);
  });
  $('graph').replaceChildren(); resetView();
  $('graph').dataset.compact=String(compact.matches);
  for (const edge of edges) {
    if (!points.has(edge.source) || !points.has(edge.target)) continue;
    const [x1,y1]=points.get(edge.source),[x2,y2]=points.get(edge.target);
    $('graph').append(element('line',{x1,y1,x2,y2,class:'edge'+(edge.type==='contains' ? ' containment' : edge.type==='calls' ? ' call' : '')}));
  }
  for (const [nodeId,[x,y]] of points) {
    const node=byId.get(nodeId), current=nodeId===id;
    const group=element('g',{tabindex:0,role:'button','aria-label':node.name,class:'graph-node'+(node.kind==='file' ? '' : ' symbol')});
    const title=element('title',{}); title.textContent=node.name+' — '+node.path; group.append(title);
    if (current) {
      group.append(element('circle',{cx:x,cy:y,r:67,class:'selected-ring'}));
      group.append(element('rect',{x:x-(compact.matches ? 125 : 105),y:y-(compact.matches ? 37 : 33),width:compact.matches ? 250 : 210,height:compact.matches ? 74 : 66,rx:8,class:'selected-box'}));
      const kind=element('text',{x,y:y-9,'text-anchor':'middle',class:'selected-kind'}); kind.textContent=node.kind==='file' ? 'FILE' : 'SYMBOL'; group.append(kind);
      const name=element('text',{x,y:y+14,'text-anchor':'middle',class:'selected-name'});
      const limit=compact.matches ? 17 : 21; name.textContent=node.name.length>limit ? node.name.slice(0,limit-3)+'…' : node.name; group.append(name);
    } else {
      if (compact.matches) group.append(element('circle',{cx:x,cy:y,r:37,fill:'transparent'}));
      group.append(element('circle',{cx:x,cy:y,r:15,class:'node-halo'}),element('circle',{cx:x,cy:y,r:5,class:'node-core'}));
      const label=element('text',{x,y:y+34,'text-anchor':'middle',class:neighbors.indexOf(nodeId)>=12 ? 'minor-label' : ''});
      const limit=compact.matches ? 13 : 16; label.textContent=node.name.length>limit ? node.name.slice(0,limit-3)+'…' : node.name; group.append(label);
    }
    group.addEventListener('click',()=>select(nodeId));
    group.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();select(nodeId);}});
    $('graph').append(group);
    if (current && restoreFocus) group.focus();
  }
  $('relationships').replaceChildren(...edges.slice(0,100).map(edge=>{
    const other=edge.source===id ? edge.target : edge.source;
    return button(`${edge.source===id ? '→' : '←'} ${edge.type.replaceAll('_',' ')} · ${byId.get(other)?.name||other}`,()=>select(other));
  }));
  if (!edges.length) { const note=document.createElement('p'); note.textContent='No recorded connections. Explore another symbol or ask Nova about this file.'; $('relationships').append(note); }
}
$('impact').addEventListener('click',()=>{
  if (!selected) return;
  let frontier=new Set(data.nodes.filter(node=>node.path===selected.path).map(node=>node.id)), seen=new Set(frontier);
  for (let hop=0;hop<4;hop++) {
    const next=new Set();
    for (const id of frontier) for (const caller of incoming.get(id)||[]) if (!seen.has(caller)) { seen.add(caller); next.add(caller); }
    frontier=next;
  }
  const affected=[...seen].map(id=>byId.get(id)).filter(Boolean);
  text('relationship-heading','POTENTIAL CHANGE IMPACT'); $('relationships').replaceChildren();
  const note=document.createElement('p'); note.textContent=`${affected.length} nodes within 4 incoming dependency hops of this file. Showing up to 100; dynamic dependencies may be missing.`;
  $('relationships').append(note,...affected.slice(0,100).map(node=>button(`${node.name} — ${node.path}`,()=>select(node.id))));
});
function tour() {
  const path=data.tour[tourIndex]; text('tour-title',path ? `Stop ${tourIndex+1} of ${data.tour.length}` : 'No tour available'); text('tour-path',path||'Run /onboard refresh to build a learning path.');
  $('previous').disabled=tourIndex===0; $('next').disabled=tourIndex>=data.tour.length-1; $('tour-map').disabled=!path;
  $('tour-symbols').replaceChildren(...data.nodes.filter(node=>node.path===path).slice(0,30).map(node=>button(node.name,()=>{tab('map');select(node.id);})));
  $('tour-stops').replaceChildren(...data.tour.map((name,index)=>{
    const item=document.createElement('li'), stop=button('',()=>{tourIndex=index;tour();});
    if (index===tourIndex) stop.setAttribute('aria-current','step');
    const order=document.createElement('span'); order.className='stop-number'; order.textContent=String(index+1).padStart(2,'0');
    const label=document.createElement('span'); label.className='node-name'; label.textContent=name;
    stop.title=name; stop.append(order,label); item.append(stop); return item;
  }));
}
$('previous').addEventListener('click',()=>{tourIndex--;tour();}); $('next').addEventListener('click',()=>{tourIndex++;tour();});
$('tour-map').addEventListener('click',()=>{tab('map');select('file:'+data.tour[tourIndex]);});
function prepare() {
  const question=$('question').value.replace(/\s+/g,' ').trim(); if (!question) return;
  $('prepare').disabled=false; $('ask-command').value='/onboard ask '+question; $('ask-command').focus(); $('ask-command').select();
}
$('question').addEventListener('input',()=>{$('prepare').disabled=!$('question').value.trim();});
$('prepare').addEventListener('click',prepare);
document.querySelectorAll('[data-question]').forEach(node=>node.addEventListener('click',()=>{$('question').value=node.dataset.question;prepare();}));
results(); tour(); select(data.hotspots[0]||data.nodes[0]?.id);
</script>
</body>
</html>
