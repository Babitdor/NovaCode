# Evaluation virtualenv (managed by uv)
.venv/

# Secrets — API keys for models, LangSmith, GitHub, etc.
.env

# Isolated home directory eval runs use instead of the developer's ~/.nova
.eval-home*/

# Task definitions fetched with `harbor dataset download` for inspection
datasets/

# Harbor job outputs (trajectories, logs, per-trial artifacts)
jobs/

# Terminal-Bench 2.0 task dataset — a separate upstream git repo cloned in
# (re-obtainable via the harbor dataset fetch); don't vendor it as a submodule.
terminal-bench-2/

# Python caches
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
